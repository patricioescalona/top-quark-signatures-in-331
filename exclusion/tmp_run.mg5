set automatic_html_opening False --no_save
set notification_center False --no_save

launch proc-1
shower=Pythia8
detector=Delphes
analysis=OFF
set mass 36 980
set tanphi 1 0.0536257837191
set width 36 Auto
set nevents 1000
set ebeam1 7000
set ebeam2 7000

